{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kn-stack/schemas/qtcn-actuals.schema.json",
  "title": "qtcn-actuals/v1 — số liệu THẬT từ xưởng, ghi ngược để hiệu chỉnh định mức",
  "description": "Giai đoạn 4 của pipeline (vòng phản hồi): mỗi record = một quan sát thực tế (giờ công / vật tư / NDT) của một nguyên công trên một sản phẩm, đối chiếu với ước tính từ định mức. Lưu append-only dạng JSONL (mỗi dòng một record). Sau 3–5 sản phẩm, hệ số ở đây chuyển định mức từ ước tính sang dữ liệu thật — tài sản khó sao chép của Workshop X.",
  "type": "object",
  "required": ["schema", "product_code", "nguyen_cong", "date", "type", "recorded_by"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "qtcn-actuals/v1" },
    "product_code": { "type": "string", "minLength": 1 },
    "product_name": { "type": ["string", "null"] },
    "seed_ref": {
      "type": "object",
      "description": "truy vết về seed/định mức đã dùng để lập ước tính",
      "properties": {
        "file": { "type": "string" },
        "sha256": { "type": "string" },
        "extractor_version": { "type": "string" }
      }
    },
    "nguyen_cong": { "type": "string", "minLength": 1, "description": "mã nguyên công theo QTCN (vd NC05-HAN)" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "recorded_by": { "type": "string", "minLength": 1 },
    "type": { "enum": ["labor", "material", "ndt", "other"] },
    "labor": {
      "type": "object",
      "required": ["actual_hours"],
      "properties": {
        "est_hours": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "actual_hours": { "type": "number", "exclusiveMinimum": 0 },
        "workers": { "type": ["integer", "null"], "minimum": 1 },
        "grade": { "type": ["string", "null"], "description": "bậc thợ (giáo trình hàn Bậc 0–5)" },
        "weld_length_m": { "type": ["number", "null"], "exclusiveMinimum": 0,
          "description": "m hàn thực hiện — cho suất m/giờ theo tư thế" },
        "position": { "type": ["string", "null"], "description": "tư thế hàn (PA/PB/PF…)" }
      }
    },
    "material": {
      "type": "object",
      "required": ["issued_kg"],
      "properties": {
        "item": { "type": ["string", "null"] },
        "est_kg": { "type": ["number", "null"], "exclusiveMinimum": 0, "description": "khối lượng CAD × hệ số hao hụt đã dùng trong định mức" },
        "net_kg": { "type": ["number", "null"], "exclusiveMinimum": 0, "description": "khối lượng CAD thuần (từ seed)" },
        "issued_kg": { "type": "number", "exclusiveMinimum": 0, "description": "vật tư XUẤT KHO thật" },
        "scrap_kg": { "type": ["number", "null"], "minimum": 0, "description": "đầu mẩu/phoi thu hồi" }
      }
    },
    "ndt": {
      "type": "object",
      "required": ["method", "checked"],
      "properties": {
        "method": { "enum": ["VT", "PT", "MT", "UT", "RT"] },
        "checked": { "type": "integer", "minimum": 1, "description": "số mối/đoạn kiểm" },
        "defects": { "type": "integer", "minimum": 0 },
        "defect_types": { "type": "array", "items": { "type": "string" } },
        "reworked": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "note": { "type": ["string", "null"] }
  }
}
