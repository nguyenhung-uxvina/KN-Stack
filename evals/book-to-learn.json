{
  "skill": "book-to-learn",
  "version": "1.1",
  "description": "Binary assertions for /book-to-learn — orchestrator học sách → ứng dụng đo được trong ~30 ngày. Mỗi assertion bắt buộc khớp một câu HÀNH VI, không chỉ một từ khoá, để không thể đạt chỉ nhờ frontmatter.",
  "mode": "static",
  "test_input": "book to learn Profit First target VN-TGT-F",
  "assertions": [
    {"id": "BTL-PHASES", "name": "phases_L0_to_L7", "check": "defines phase L7 as an actual heading", "regex": "### L7 Retro", "required": true},
    {"id": "BTL-GATE", "name": "gate_script", "check": "gate checker must exit 0 before a phase counts as done", "regex": "btl_gate_check\\.py[\\s\\S]{0,60}exit 0", "required": true},
    {"id": "BTL-L0", "name": "real_problem_block", "check": "L0 blocks (DỪNG) without a real Workshop X problem", "regex": "vấn đề thật.{0,40}DỪNG", "required": true},
    {"id": "BTL-FEYNMAN", "name": "feynman_gate", "check": "Feynman gate is CEO-authored", "regex": "Cổng Feynman.{0,40}CEO tự viết", "required": true},
    {"id": "BTL-FEYNMAN-BEFORE-L5", "name": "feynman_before_l5", "check": "Feynman gate appears before the L5 heading in document order", "regex": "Cổng Feynman[\\s\\S]*### L5", "required": true},
    {"id": "BTL-CARD", "name": "experiment_card", "check": "L5 produces Experiment_Card.md from its template", "regex": "TPL/experiment-card\\.md[\\s\\S]{0,20}Experiment_Card\\.md", "required": true},
    {"id": "BTL-DMIR", "name": "dmir_definition", "check": "DMIR = Diagnose-Model-Intervene-Reflect", "regex": "Diagnose.{1,3}Model.{1,3}Intervene.{1,3}Reflect", "required": true},
    {"id": "BTL-DMIR-SKILLS", "name": "dmir_skills", "check": "delegates to DMIR skills", "regex": "/archetype.{0,40}/cld", "required": true},
    {"id": "BTL-TOC", "name": "toc_skills", "check": "uses constraint and leverage skills", "regex": "/constraint.{0,40}/leverage", "required": true},
    {"id": "BTL-LEARN-M", "name": "learn_methodology", "check": "chunking/Feynman routed through learn-methodology", "regex": "(Chunking|Feynman).{0,40}learn-methodology", "required": true},
    {"id": "BTL-LEARN-P", "name": "learn_practice", "check": "drill/interleaving routed through learn-practice", "regex": "(Drill|interleaving).{0,40}learn-practice", "required": true},
    {"id": "BTL-LEARN-T", "name": "learn_track", "check": "journal/rubric routed through learn-track", "regex": "(Journal|rubric).{0,40}learn-track", "required": true},
    {"id": "BTL-TEACH-MANUAL", "name": "learn_teach_manual", "check": "CEO runs /learn-teach manually", "regex": "tự gõ `?/learn-teach", "required": true},
    {"id": "BTL-ANALYZE", "name": "analyze_meta_learning", "check": "uses /analyze part 3 (Meta-Learning)", "regex": "/analyze.{0,20}Phần 3", "required": true},
    {"id": "BTL-META", "name": "meta_ledger", "check": "appends a row to cycles.jsonl", "regex": "ối.{0,20}cycles\\.jsonl", "required": true},
    {"id": "BTL-NO-PERSONA", "name": "no_nlm_persona", "check": "forbids chat_configure custom goal", "regex": "cấm.{0,10}chat_configure", "required": true},
    {"id": "BTL-NO-PUBLIC", "name": "no_public_share", "check": "notebooks never shared publicly", "regex": "không bao giờ share public", "required": true},
    {"id": "BTL-GROUNDING", "name": "sources_used_check", "check": "rejects answers with sources_used 0", "regex": "sources_used.{0,10}0", "required": true},
    {"id": "BTL-QUICK", "name": "quick_flag_limits", "check": "--quick cannot skip L0/Feynman/L5/L7", "regex": "--quick.{0,60}(không|Không) bỏ được L0", "required": true},
    {"id": "BTL-GALAXY", "name": "galaxy_gate", "check": "Galaxy candidates are proposal-only through galaxy-gate", "regex": "chỉ đề xuất.{0,40}galaxy-gate", "required": true},
    {"id": "BTL-REFS", "name": "references", "check": "links reference files as real markdown links", "regex": "\\[references/(dmir-unified|phase-contracts)\\.md\\]", "required": true},
    {"id": "BTL-L3-APPROVE", "name": "l3_source_approval_in_words", "check": "CEO's L3 source approval is recorded in words in Claims.md", "regex": "## CEO duyệt nguồn", "required": true},
    {"id": "BTL-L5-APPROVE", "name": "l5_card_approval_in_words", "check": "ceo_duyet is filled only after CEO approves the card in words", "regex": "CEO duyệt bằng lời.{0,60}ceo_duyet", "required": true},
    {"id": "BTL-L7-DECIDE", "name": "l7_keep_adapt_drop", "check": "CEO decides keep/adapt/drop at L7", "regex": "keep\\s*/\\s*adapt\\s*/\\s*drop", "required": true},
    {"id": "BTL-VN-NUMBERS", "name": "source_context_numbers", "check": "book figures stay in source context", "regex": "CẦN-CHUYỂN-VN", "required": false}
  ],
  "passing_score": 24,
  "total_required": 24,
  "total_optional": 1
}
