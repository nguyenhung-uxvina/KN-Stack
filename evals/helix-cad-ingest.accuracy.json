      "required": true },
    { "id": "Q03", "question": "Mã khung tên có bị đánh dấu LOW-confidence không?",
      "query": "meta.code_confidence", "expected": "LOW", "match": "exact",
      "required": true },
    { "id": "Q04", "question": "Tỷ lệ bản vẽ?",
      "query": "meta.scale", "expected": "1:2", "match": "exact",
      "required": true },
    { "id": "Q05", "question": "Đơn vị bản vẽ?",
      "query": "meta.units", "expected": "mm", "match": "exact",
      "required": true },
    { "id": "Q06", "question": "Sản phẩm được nhận diện?",
      "query": "meta.product", "expected": "TRƯỢT", "match": "contains",
      "required": true },
    { "id": "Q07", "question": "Số lỗ Ø6.6?",
      "query": "holes[dia=6.6].count", "expected": 4, "match": "exact",
      "confidence_query": "holes[dia=6.6].confidence", "min_confidence": "HIGH",
      "required": true },
    { "id": "Q08", "question": "Số lỗ Ø12?",
      "query": "holes[dia=12.0].count", "expected": 2, "match": "exact",
      "confidence_query": "holes[dia=12.0].confidence", "min_confidence": "HIGH",
      "required": true },
    { "id": "Q09", "question": "Tổng số lỗ trên chi tiết?",
      "query": "holes[]|sum-of:count", "expected": 6, "match": "exact",
      "required": true },
    { "id": "Q10", "question": "Số nhóm đường kính lỗ khác nhau?",
      "query": "holes[]|count", "expected": 2, "match": "exact",
      "required": true },
    { "id": "Q11", "question": "Kích thước dài tổng (linear dim) đọc được?",
      "query": "dimensions[0].value", "expected": 100.0, "match": "approx", "tolerance": 0.5,
      "confidence_query": "dimensions[0].confidence", "min_confidence": "HIGH",
      "required": true },
    { "id": "Q12", "question": "Số dòng ghi chú công nghệ bóc được?",
      "query": "process_notes|count", "expected": 2, "match": "exact",
      "required": false },
    { "id": "Q13", "question": "Phân loại mật được truyền đúng?",
      "query": "meta.classification", "expected": "HẠN-CHẾ", "match": "exact",
      "required": true },
    { "id": "Q14", "question": "Đường kính lỗ lớn nhất?",
      "query": "holes[]|max-of:dia", "expected": 12.0, "match": "approx", "tolerance": 0.1,
      "required": false }
  ]
}
