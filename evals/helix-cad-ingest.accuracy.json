  "ingest_script": "skills/helix/helix-cad-ingest/ingest.py",
  "passing_score": 95,
  "questions": [
    { "id": "Q01", "question": "Vật liệu chi tiết?",
      "query": "meta.material", "expected": "NHÔM 5083", "match": "exact",
      "required": true },
    { "id": "Q02", "question": "Mã chi tiết trong khung tên?",
